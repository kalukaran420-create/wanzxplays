# ==========================================
# PulseCord Production Environment Variables (Railway / Hosting)
# ==========================================

# 1. Server Port (Railway will automatically set PORT in production)
PORT=5000

# 2. Node Environment ('production' or 'development')
NODE_ENV=production

# 3. PostgreSQL Database Connection String
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# 4. JWT Secret Key (Generate a random 32+ character string for token signing)
JWT_SECRET=your_super_secret_random_32_character_jwt_string_here

# 5. Client Frontend URL (Used for CORS restrictions in production)
# Example: https://pulsecord-production.up.railway.app
CLIENT_URL=https://your-production-app.up.railway.app

# 6. Google OAuth 2.0 Credentials (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
